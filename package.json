{
  "name": "chess-arena",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "predev": "npm run prepare:assets",
    "prebuild": "npm run prepare:assets && node scripts/export-source.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "wrangler d1 migrations apply chess-arena --local",
    "predeploy": "node scripts/check-deploy.mjs"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "^5.3.0",
    "@lichess-org/chessground": "10.5.0",
    "chess.js": "^1.4.0",
    "idb": "^8.0.4",
    "isbot": "^5.1.36",
    "openid-client": "^6.8.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.0",
    "stockfish": "19.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.5.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jsonc-parser": "^3.3.1",
    "miniflare": "^5.20261023.1-beta",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.2",
    "tar": "^7.5.22",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  },
  "license": "GPL-3.0-or-later",
  "overrides": {
    "undici": "^7.30.1"
  }
}
