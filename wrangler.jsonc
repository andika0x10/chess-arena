{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chess-arena",
  "compatibility_date": "2026-10-23",
  "main": "./workers/app.ts",
  "vars": { "APP_ORIGIN": "https://chess-arena.andikadinata.workers.dev", "GOOGLE_CLIENT_ID": "134087871319-pomch8cpf5t26acl2m52me8amecmq669.apps.googleusercontent.com" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chess-arena",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": true },
  "upload_source_maps": true,
}
